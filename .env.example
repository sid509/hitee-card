APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Card Management (validator + issuer desktop integration) ---------------

# Base URL written into device-provisioning QR codes as `apiUrl`. The Flutter
# validator reads it during Device Setup and uses it for register / heartbeat /
# blocklist / trip-sync for the life of the device. MUST be reachable from the
# bus devices — on staging/production set it explicitly
# (e.g. https://card-stg.hitee.ai/api/v1). If left empty the QR falls back to
# ${APP_URL}/api/v1, which is wrong whenever APP_URL is localhost or the API
# lives on a different host.
CARD_MANAGEMENT_QR_API_URL=

# Auth gate for the Card Management API. The issuer desktop sends
# CM_WORKSTATION_API_TOKEN as `Authorization: Bearer` on every call, so the
# same secret must be configured on each office workstation (Settings page).
# Generate with `openssl rand -hex 32`. Keep CM_AUTH_REQUIRED=true everywhere
# except local tests — disabling it leaves card issuance endpoints open.
CM_AUTH_REQUIRED=true
CM_WORKSTATION_API_TOKEN=

# Operator-issued secret that lets a validator device re-register (e.g. after
# a wipe or token loss) without its previous Bearer token. When empty,
# re-registration requires the device's current token — a wiped device can
# never recover and must be recreated in the admin. Always set this on a real
# deployment; keep it out of the QR payload.
CM_VALIDATOR_PROVISIONING_SECRET=

# Keep false until the NACHA/ISO 20022 payout layouts are verified bank-compliant.
CM_SETTLEMENT_BANK_FORMATS_ENABLED=false

# --- Key envelope provider (ADR 0018) ---------------------------------------
# Which component produces card key envelopes (used by initialization,
# issuance, recharge, replacement — validator taps do NOT need it):
#
#   service → separate Node.js Key Service over HTTP. REQUIRED in production:
#             Laravel relays opaque envelopes and never sees plaintext keys.
#   lab     → Laravel decrypts an encrypted LAB keystore in-process and
#             produces identical envelopes itself. Lab/staging convenience:
#             no Node service to deploy. Refused unless CARD_ENVIRONMENT=LAB.
CARD_KEY_PROVIDER=service

# Remote Key Service connection (CARD_KEY_PROVIDER=service).
# Deploy it on the same host over loopback; it has no DB and only Laravel
# calls it. KEY_SERVICE_INTERNAL_TOKEN must equal the service's
# INTERNAL_SERVICE_TOKEN (min 32 chars, `openssl rand -hex 32`).
KEY_SERVICE_URL=http://127.0.0.1:8100
KEY_SERVICE_TIMEOUT_MS=5000
KEY_SERVICE_INTERNAL_TOKEN=

# In-process lab keystore (CARD_KEY_PROVIDER=lab only).
# The keystore file is AES-256-GCM encrypted; the KEK unwraps it. Regenerate
# via hitee-card-issuer key-service: scripts/create-lab-keystore.js.
# LAB_KEYSTORE_PATH=storage/app/keys/hitee-lab-keystore.json
# LAB_KEYSTORE_KEK=   # 64 hex chars — prefer LAB_KEYSTORE_KEK_FILE on servers
# LAB_KEYSTORE_KEK_FILE=
# Opening wallet balance (minor units) created when a card is issued.
# CM_WALLET_OPENING_BALANCE=5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATION_TOKEN=
FCM_SERVER_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Road-distance routing (OSRM-compatible backend).
# Default is the public demo server — rate-limited, not for production.
# Point at a self-hosted OSRM instance for real traffic; leave empty to disable.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT=4
OSRM_CACHE_TTL=300
